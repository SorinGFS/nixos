{
    "workbench.sideBar.location": "right",
    "editor.fontLigatures": true,
    "editor.fontFamily": "SFMono-Regular, Menlo, Monaco, Consolas, 'Fira Code Retina', 'Fira Code', \"Liberation Mono\", \"Courier New\", monospace",
    "git.enableSmartCommit": true,
    "prettier.jsxSingleQuote": true,
    "prettier.singleQuote": true,
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "prettier.tabWidth": 4,
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "html.format.indentHandlebars": true,
    "prettier.printWidth": 600,
    "html.format.wrapLineLength": 1000,
    "liveServer.settings.donotShowInfoMsg": true,
    "workbench.iconTheme": "vscode-icons",
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.rightClickBehavior": "paste",
    "terminal.integrated.copyOnSelection": true,
    "terminal.external.linuxExec": "kitty",
    "debug.console.fontSize": 15,
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "editor.occurrencesHighlight": "off",
    "editor.autoSurround": "never",
    "explorer.confirmDelete": false,
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.largeFileOptimizations": false,
    "phpfmt.psr2": false,
    "intelephense.format.braces": "k&r",
    "intelephense.format.enable": false,
    "phpfmt.enable_auto_align": true,
    "vsicons.dontShowNewVersionMessage": true,
    "rest-client.fontSize": 15,
    "rest-client.fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe WP', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
    "markdown.preview.fontSize": 15,
    "explorer.openEditors.visible": 1,
    "editor.fontSize": 15,
    "workbench.colorTheme": "Night Owl (No Italics)",
    "markdown.preview.fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe WP', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
    "editor.find.addExtraSpaceOnTop": false,
    "[scss]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.bracketPairsHorizontal": true,
    "editor.guides.highlightActiveBracketPair": true,
    "workbench.colorCustomizations": {
        "editorBracketHighlight.foreground1": "#d6fd73",
        "editorBracketHighlight.foreground2": "#fd73d4",
        "editorBracketHighlight.foreground3": "#fdf278",
        "editorBracketHighlight.foreground4": "#ca7dfd",
        "editorBracketHighlight.foreground5": "#ffc97e",
        "editorBracketHighlight.foreground6": "#739ffd",
        "editorBracketHighlight.unexpectedBracket.foreground": "#ff0000"
    },
    "githubPullRequests.fileListLayout": "tree",
    "telemetry.telemetryLevel": "off",
    "rest-client.enableTelemetry": false,
    "files.associations": {
        "init": "plaintext",
        "*.json": "json"
    },
    "explorer.compactFolders": false,
    "remote.SSH.remotePlatform": {
        "web-linux": "linux"
    },
    "intelephense.stubs": [
        "apache",
        "bcmath",
        "bz2",
        "calendar",
        "com_dotnet",
        "Core",
        "ctype",
        "curl",
        "date",
        "dba",
        "dom",
        "enchant",
        "exif",
        "FFI",
        "fileinfo",
        "filter",
        "fpm",
        "ftp",
        "gd",
        "gettext",
        "gmp",
        "hash",
        "iconv",
        "imap",
        "intl",
        "json",
        "ldap",
        "libxml",
        "mbstring",
        "meta",
        "mysqli",
        "oci8",
        "odbc",
        "openssl",
        "pcntl",
        "pcre",
        "PDO",
        "pgsql",
        "Phar",
        "posix",
        "pspell",
        "readline",
        "Reflection",
        "session",
        "shmop",
        "SimpleXML",
        "snmp",
        "soap",
        "sockets",
        "sodium",
        "SPL",
        "sqlite3",
        "standard",
        "superglobals",
        "sysvmsg",
        "sysvsem",
        "sysvshm",
        "tidy",
        "tokenizer",
        "xml",
        "xmlreader",
        "xmlrpc",
        "xmlwriter",
        "xsl",
        "Zend OPcache",
        "zip",
        "zlib",
        "mongodb"
    ],
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "window.zoomLevel": 0.8,
    "json.schemas": [],
    "json.validate.enable": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "diffEditor.ignoreTrimWhitespace": false,
    "emmet.includeLanguages": {
        "javascript": "javascriptreact"
    },
    "window.newWindowProfile": "Default",
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorStyleInactive": "underline",
    "workbench.editor.empty.hint": "hidden",
    "git.confirmSync": false,
    "workbench.startupEditor": "none",
    "editor.inlineSuggest.enabled": false,
    "explorer.confirmPasteNative": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "terminal.integrated.initialHint": false,
    "git.blame.statusBarItem.enabled": false,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "git.openRepositoryInParentFolders": "never",
    "workbench.experimental.modernUIEditorTabStyle": "pill",
    "extensions.autoCheckUpdates": true,
    "extensions.autoUpdate": true,
    "terminal.integrated.fontFamily": "MesloLGM Nerd Font Mono"
}
